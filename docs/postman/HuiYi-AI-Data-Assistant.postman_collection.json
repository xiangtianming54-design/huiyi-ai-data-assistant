{
  "info": {
    "name": "HuiYi AI Data Assistant",
    "description": "HuiYi AI Data Assistant API 集合（P2 阶段：健康检查 / 文档解析 / 知识库上传）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "java_base", "value": "http://localhost:8080" },
    { "key": "python_base", "value": "http://localhost:8001" }
  ],
  "item": [
    {
      "name": "健康检查",
      "item": [
        {
          "name": "Java 健康检查",
          "request": {
            "method": "GET",
            "url": "{{java_base}}/api/health"
          }
        },
        {
          "name": "Python 健康检查",
          "request": {
            "method": "GET",
            "url": "{{python_base}}/health"
          }
        }
      ]
    },
    {
      "name": "知识库",
      "item": [
        {
          "name": "上传知识文档（Java）",
          "request": {
            "method": "POST",
            "url": "{{java_base}}/api/knowledge/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "sample-data/knowledge/business-glossary.md" }
              ]
            }
          }
        },
        {
          "name": "文档解析（Python 直连）",
          "request": {
            "method": "POST",
            "url": "{{python_base}}/api/documents/parse",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "sample-data/knowledge/business-glossary.md" },
                { "key": "chunk_size", "value": "500", "type": "text" },
                { "key": "chunk_overlap", "value": "50", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "文档列表",
          "request": {
            "method": "GET",
            "url": "{{java_base}}/api/knowledge/docs"
          }
        },
        {
          "name": "删除文档",
          "request": {
            "method": "DELETE",
            "url": "{{java_base}}/api/knowledge/docs/1"
          }
        }
      ]
    },
    {
      "name": "智能问答",
      "item": [
        {
          "name": "RAG 问答（非流式）",
          "request": {
            "method": "POST",
            "url": "{{java_base}}/api/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"s-001\",\n  \"question\": \"什么是有效订单？\"\n}"
            }
          }
        },
        {
          "name": "RAG 问答（SSE 流式）",
          "request": {
            "method": "POST",
            "url": "{{java_base}}/api/chat/stream",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"什么是有效订单？\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "数据分析",
      "item": [
        {
          "name": "Text-to-SQL 查询",
          "request": {
            "method": "POST",
            "url": "{{java_base}}/api/analysis/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"上个月销售额最高的 10 个商品是什么？\"\n}"
            }
          }
        },
        {
          "name": "SQL 安全校验（Python 直连）",
          "request": {
            "method": "POST",
            "url": "{{python_base}}/api/sql/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"DELETE FROM sales_orders\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "向量库",
      "item": [
        {
          "name": "向量检索",
          "request": {
            "method": "POST",
            "url": "{{python_base}}/api/vector/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"什么是有效订单？\",\n  \"top_k\": 5,\n  \"collection_name\": \"huiyi_knowledge\"\n}"
            }
          }
        },
        {
          "name": "向量删除",
          "request": {
            "method": "POST",
            "url": "{{python_base}}/api/vector/delete",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"business-glossary.md\",\n  \"collection_name\": \"huiyi_knowledge\"\n}"
            }
          }
        }
      ]
    }
  ]
}
