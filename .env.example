# ===== MySQL =====
# 仅用于本地 Demo 的 root 密码，生产环境务必更换
MYSQL_ROOT_PASSWORD=huiyi123
# 容器 MySQL 暴露到宿主机的端口（本机 3306 被本地 MySQL 占用时保持 3307）
MYSQL_HOST_PORT=3307

# ===== LLM OpenAI 兼容 API（必填，chat 与 embedding 可不同服务商时需自行扩展） =====
# 推荐硅基流动（siliconflow.cn，有免费模型额度）：
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_MODEL=

# Docker Desktop 编后端镜像时，把腾讯 Maven 域名指到宿主机解析的 IPv4（可随时覆盖）
# TENCENT_MAVEN_IP=123.6.105.104

# ===== v0.7 认证 =====
REGISTER_ENABLED=true
DEFAULT_MEMBER_ROLE=VIEWER
JWT_SECRET=please-change-me-to-a-32-byte-minimum-secret
JWT_ISSUER=huiyi
JWT_AUDIENCE=huiyi-api
JWT_ACCESS_TOKEN_TTL=1800
JWT_REFRESH_TOKEN_TTL=604800
LOGIN_FAIL_MAX_ATTEMPTS=5
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
MIGRATED_USERNAME=migrated
DEFAULT_WORKSPACE_CODE=default

# ===== v0.8 可观测 =====
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
LLM_COST_ENABLED=true
LLM_COST_DEFAULT=0
TRACE_STEPS_ENABLED=true
TRACE_MAX_STEPS=20
